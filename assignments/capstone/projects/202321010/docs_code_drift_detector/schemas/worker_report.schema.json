{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker_report",
  "title": "WorkerReport",
  "type": "object",
  "required": ["task_id", "run_id", "agent_name", "status", "output"],
  "properties": {
    "task_id": { "type": "string" },
    "run_id": { "type": "string" },
    "agent_name": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["success", "failure", "skipped"]
    },
    "output": { "type": "object" },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "status"],
        "properties": {
          "tool": { "type": "string" },
          "status": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
