{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TraceLedger Task Packet",
  "type": "object",
  "properties": {
    "task_id": { "type": "string" },
    "objective": { "type": "string" },
    "scope": {
      "type": "object",
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "raw_text": { "type": "string" }
      }
    },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "budget": {
      "type": "object",
      "properties": {
        "max_turns": { "type": "integer" },
        "max_tokens": { "type": "integer" }
      }
    },
    "escalation": {
      "type": "object",
      "properties": {
        "ask_human_if": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "required": ["task_id", "objective", "scope", "allowed_tools", "acceptance", "budget"]
}
